# Скопируй в .env и заполни.

POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=

POSTGRES_ORDERS_DB=orders_db
POSTGRES_ORDERS_USER=orders_user
POSTGRES_ORDERS_PASSWORD=

POSTGRES_PAYMENTS_DB=payments_db
POSTGRES_PAYMENTS_USER=payments_user
POSTGRES_PAYMENTS_PASSWORD=

# Сервисы: креды берутся из POSTGRES_*_* выше
ORDERS_DB_URL=jdbc:postgresql://postgres:5432/orders_db
PAYMENTS_DB_URL=jdbc:postgresql://postgres:5432/payments_db

KAFKA_BOOTSTRAP_SERVERS=kafka:9092
REDIS_HOST=redis
REDIS_PORT=6379

# Общий секрет order-service (подписывает) и gateway (проверяет). HS256 — не короче 32 байт.
JWT_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Ведро токенов на покупателя (для анонимных запросов — на адрес клиента).
RATE_LIMIT_REPLENISH_RATE=20
RATE_LIMIT_BURST_CAPACITY=40

# Наружу торчит только nginx; серты — ./scripts/gen-certs.sh
HTTP_PORT=80
HTTPS_PORT=443

GRAFANA_ADMIN_PASSWORD=
